{
  "sdk": 2,
  "id": "neon-bid",
  "name": "NEON BID",
  "title": "Neon Bid",
  "blurb": "Twelve gems, 100 credits, sealed bids. The winner pays the second-highest bid.",
  "description": "Twelve gems, a hundred credits, every bid sealed. The winner pays the second-highest bid, so bid what a gem is really worth to you \u2014 sets and a rainbow score.",
  "entry": "index.html",
  "rules": "RULES.md",
  "shape": "free",
  "seats": {
    "min": 2,
    "max": 8
  },
  "bots": true,
  "kind": "ffa",
  "tags": [
    "alone",
    "party",
    "strategy"
  ],
  "categories": [
    "party",
    "strategy"
  ],
  "preview": "../../assets/neon-bid.webp",
  "records": [
    {
      "id": "points",
      "title": "Best score",
      "of": "score",
      "best": "max",
      "unit": "points"
    },
    {
      "id": "credits",
      "title": "Most credits left in a win",
      "of": "facts.credits",
      "best": "max",
      "when": {
        "won": true
      }
    }
  ],
  "achievements": [
    {
      "id": "first-win",
      "title": "First Win",
      "description": "Win a game of Neon Bid.",
      "glyph": "🏁",
      "when": {
        "won": true
      }
    },
    {
      "id": "beat-3",
      "title": "Beat 3 Bots",
      "description": "Win against 3 or more bots.",
      "glyph": "🤖",
      "when": {
        "won": true,
        "bots": {
          ">=": 3
        }
      }
    },
    {
      "id": "full-table",
      "title": "Full Table",
      "description": "Win against 7 bots.",
      "glyph": "👑",
      "when": {
        "won": true,
        "bots": {
          ">=": 7
        }
      }
    },
    {
      "id": "rainbow",
      "title": "Rainbow",
      "description": "Finish holding a gem of every colour.",
      "glyph": "🌈",
      "when": {
        "facts.rainbow": true
      }
    },
    {
      "id": "frugal",
      "title": "Frugal",
      "description": "Win with 50 credits or more left.",
      "glyph": "💰",
      "when": {
        "won": true,
        "facts.credits": {
          ">=": 50
        }
      }
    },
    {
      "id": "ten-points",
      "title": "Ten Points",
      "description": "Score 10 points or more in a game.",
      "glyph": "💎",
      "when": {
        "score": {
          ">=": 10
        }
      }
    },
    {
      "id": "five-in-a-row",
      "title": "5 in a Row",
      "description": "Win 5 games in a row.",
      "glyph": "🔥",
      "when": {
        "won": true
      },
      "streak": 5
    },
    {
      "id": "ten-wins",
      "title": "Ten Wins",
      "description": "Win 10 games.",
      "glyph": "🏆",
      "when": {
        "won": true
      },
      "count": 10
    }
  ],
  "license": "MIT",
  "author": "lokeshmohanty",
  "repo": "https://github.com/lokeshmohanty/games"
}
